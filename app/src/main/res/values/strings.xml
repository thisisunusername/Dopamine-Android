    <!-- Settings: hide / unhide jailbreak -->
    <string name="settings_section_actions">Actions</string>
    <string name="settings_hide_jailbreak">Hide Jailbreak</string>
    <string name="settings_unhide_jailbreak">Unhide Jailbreak</string>
    <string name="settings_hide_jailbreak_hint">\"Hide Jailbreak\" temporarily removes jailbreak-related files until the next rejailbreak</string>
    <string name="settings_hide_jailbreak_note">\"Hide Jailbreak\" can be used to temporarily disable the jailbreak to get past certain jailbreak detection methods. It is not entirely effective and does not conceal everything, but should get the device to a similar state as to the state it is in after a reboot before rejailbreaking. It is not an adequate replacement or substitute for RootHide. No support is offered for this option as it can cause issues, use it at your own risk.</string>

