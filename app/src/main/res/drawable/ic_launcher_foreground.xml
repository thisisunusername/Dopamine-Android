<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher icon: the two interleaved arcs of the Dopamine mark, on the app's own background.

    Drawn as a vector rather than shipped as PNGs so one file covers every density, and so the shape
    stays identical to DopamineMark() in Compose instead of drifting from it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#08080A"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Upper arc: drawn from 40° sweeping 250°, mirrored about the centre. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M38,35 A20,20 0 1,1 38,73" />

    <!-- Lower arc, offset so the two read as interleaved rather than as one ring. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M70,73 A20,20 0 1,1 70,35" />
</vector>