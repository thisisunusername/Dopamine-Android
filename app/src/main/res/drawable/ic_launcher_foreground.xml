<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground of the adaptive icon: the Dopamine mark, traced from the iOS AppIcon.

  Measurements taken from Icon-60@3x.png (180x180): the white shape is an annulus
  centred at (89.5, 89.5) with outer radius 59.5 and inner radius 33, i.e. a circle
  of radius 46.25 stroked at width 26.5. It is solid everywhere except one notch in
  the upper right (roughly 322..338 degrees clockwise from straight up).

  In an adaptive icon the visible safe zone is the middle 72 of 108, so the 180-wide
  artwork is scaled by 72/119 to sit inside it and the canvas is recentred to 54,54.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      One arc covering 344 of the 360 degrees, stroked rather than filled so the ring
      width stays uniform. Butt caps: round caps would round off the two ends of the
      notch, which the source artwork keeps flat.
    -->
    <path
        android:pathData="M43.52,28.05 A27.98,27.98 0 1 0 36.77,31.95"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="16.03"
        android:strokeLineCap="butt" />
</vector>