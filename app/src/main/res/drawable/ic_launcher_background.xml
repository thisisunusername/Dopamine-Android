<?xml version="1.0" encoding="utf-8"?>
<!--
  Background of the adaptive icon: the diagonal teal gradient sampled from the iOS
  AppIcon (top-left #0A455F, bottom-right #1DB381).

  Adaptive icons are 108x108 with only the middle 72x72 guaranteed visible, so the
  gradient covers the full 108 and is angled corner to corner.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF0A455F" />
                <item android:offset="1" android:color="#FF1DB381" />
            </gradient>
        </aapt:attr>
    </path>
</vector>