<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        No permissions are declared.

        Nothing here needs one: the run reads Build.* and System.getProperty, spawns /system/bin/sh
        from its own sandbox, and resolves the home app through PackageManager, which needs no
        permission. INTERNET in particular is deliberately absent — claiming network access for an
        app that never makes a request would misrepresent it.

        The custom boot logo is picked with the system photo picker
        (ActivityResultContracts.PickVisualMedia), which returns a URI grant to this app and
        therefore needs no storage permission either.
    -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dopamine">

        <!--
            The real activity. It carries no launcher intent filter: every way into the app is
            through one of the aliases below, because the launcher icon is a property of the
            component it launches and that is the only way to change it with the theme.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Dopamine" />

        <!--
            One alias per theme. `ThemeIcon.apply` enables exactly one and disables the rest with
            DONT_KILL_APP, so switching theme changes the icon without restarting the app.

            Each alias repeats the MAIN/LAUNCHER filter: without its own filter the alias would not
            appear in the launcher at all, and enabling it would leave the app with no way in. The
            targetActivity stays MainActivity so the alias is only the label and the artwork.

            The `Default` alias is the only one enabled in the manifest; the others start disabled
            and are turned on by the app when that theme is chosen.
        -->
        <activity-alias
            android:name="com.opa334.dopamine.Launcher.Default"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_default"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_default"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.opa334.dopamine.Launcher.Ellekit"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ellekit"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_ellekit"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.opa334.dopamine.Launcher.Blue"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_blue"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_blue"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.opa334.dopamine.Launcher.Red"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_red"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_red"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.opa334.dopamine.Launcher.Purple"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_purple"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_purple"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>